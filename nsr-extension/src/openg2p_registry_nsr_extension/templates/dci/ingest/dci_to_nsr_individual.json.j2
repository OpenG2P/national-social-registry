{%- macro norm(v) -%}{{ (v or '') | string | trim | upper }}{%- endmacro -%}
{%- macro gender_enum(sex) -%}
{%- set s = norm(sex) -%}
{%- if s in ['MALE', 'M'] -%}MALE
{%- elif s in ['FEMALE', 'F'] -%}FEMALE
{%- elif s in ['OTHER', 'OTHERS'] -%}OTHERS
{%- else -%}UNKNOWN
{%- endif -%}
{%- endmacro -%}
{%- macro marital_enum(ms) -%}
{%- set s = norm(ms) | replace(' ', '_') -%}
{%- if s in ['SINGLE', 'MARRIED', 'DIVORCED', 'WIDOWED', 'SEPARATED', 'UNKNOWN'] -%}{{ s }}
{%- else -%}UNKNOWN
{%- endif -%}
{%- endmacro -%}
{# EmploymentStatusEnum: EMPLOYED, SELF_EMPLOYED, UNEMPLOYED, STUDENT, RETIRED, OTHER #}
{%- macro employment_enum(val) -%}
{%- set s = norm((val or '')) | replace(' ', '_') -%}
{%- if s == 'SELF_EMPLOYED' or ('SELF' in s and 'EMPLOY' in s) -%}SELF_EMPLOYED
{%- elif 'UNEMPLOY' in s -%}UNEMPLOYED
{%- elif s == 'EMPLOYED' -%}EMPLOYED
{%- elif 'STUDENT' in s -%}STUDENT
{%- elif 'RETIRED' in s -%}RETIRED
{%- elif s -%}OTHER
{%- endif -%}
{%- endmacro -%}
{%- macro education_level_norm(el) -%}
{%- set s = (el or '') | string | trim | lower | replace('-', '_') | replace(' ', '_') -%}
{%- if not s -%}
{%- elif s in ['none', 'no_education', 'illiterate'] -%}NONE
{%- elif s in ['primary', 'elementary'] -%}PRIMARY
{%- elif s in ['lower_secondary', 'junior_secondary'] -%}LOWER_SECONDARY
{%- elif s in ['upper_secondary', 'secondary', 'high_school'] -%}UPPER_SECONDARY
{%- elif s in ['post_secondary', 'vocational', 'technical'] -%}POST_SECONDARY
{%- elif s in ['bachelor', 'bachelors', 'undergraduate'] -%}BACHELOR
{%- elif s in ['master', 'masters', 'graduate'] -%}MASTER
{%- elif s in ['doctorate', 'doctoral', 'phd'] -%}DOCTORATE
{%- else -%}{{ s | upper }}
{%- endif -%}
{%- endmacro -%}
{%- macro income_level_norm(il) -%}
{%- set s = (il or '') | string | trim | lower | replace(' ', '_') -%}
{%- if not s -%}
{%- elif s in ['none', 'no_income'] -%}NONE
{%- elif s in ['low', 'lower'] -%}LOW
{%- elif s in ['lower_middle', 'lower-middle'] -%}LOWER_MIDDLE
{%- elif s in ['middle', 'mid', 'medium'] -%}MIDDLE
{%- elif s in ['upper_middle', 'upper-middle'] -%}UPPER_MIDDLE
{%- elif s in ['high', 'upper', 'top'] -%}HIGH
{%- else -%}{{ s | upper }}
{%- endif -%}
{%- endmacro -%}
{%- macro livelihood_from_text(t) -%}
{%- set s = norm(t) | replace(' ', '_') -%}
{%- if 'WAGE' in s or 'LABOUR' in s or 'LABOR' in s -%}WAGE_LABOR
{%- elif 'AGRIC' in s -%}AGRICULTURE
{%- elif 'LIVESTOCK' in s or 'GOAT' in s -%}LIVESTOCK
{%- elif 'FISH' in s -%}FISHING
{%- elif 'BUSINESS' in s or 'TRADE' in s -%}BUSINESS_TRADE
{%- elif 'SELF' in s and 'EMPLOY' in s -%}SELF_EMPLOYMENT
{%- elif 'GOVT' in s or 'GOVERNMENT' in s -%}GOVERNMENT_EMPLOYEE
{%- elif 'PRIVATE' in s -%}PRIVATE_SECTOR_EMPLOYEE
{%- elif 'UNEMPLOY' in s -%}UNEMPLOYED
{%- elif 'PENSION' in s -%}PENSION
{%- elif 'REMIT' in s -%}REMITTANCE
{%- elif s -%}OTHER
{%- endif -%}
{%- endmacro -%}
{%- macro domain_from_dci(label) -%}
{%- set s = (label or '') | string | trim | lower -%}
{%- if 'see' in s and 'ing' in s -%}VISION
{%- elif 'hear' in s -%}HEARING
{%- elif 'walk' in s or 'climb' in s or 'mobil' in s -%}MOBILITY
{%- elif 'remember' in s or 'concentrat' in s or 'cogn' in s -%}COGNITION
{%- elif 'self-care' in s or 'self care' in s -%}SELF_CARE
{%- elif 'communicat' in s -%}COMMUNICATION
{%- else -%}MOBILITY
{%- endif -%}
{%- endmacro -%}
{%- macro severity_from_dci(level) -%}
{%- set s = (level or '') | string | trim | lower -%}
{%- if s in ['none', 'no difficulty'] -%}NO_DIFFICULTY
{%- elif 'some' in s -%}SOME_DIFFICULTY
{%- elif 'lot' in s or 'moderate' in s -%}A_LOT_OF_DIFFICULTY
{%- elif 'unable' in s or 'cannot' in s -%}CANNOT_DO_AT_ALL
{%- else -%}SOME_DIFFICULTY
{%- endif -%}
{%- endmacro -%}
{%- macro rel_to_head(raw) -%}
{%- set s = norm(raw) | replace(' ', '_') -%}
{%- if s == 'SELF' -%}SELF
{%- elif s == 'SPOUSE' -%}SPOUSE
{%- elif s == 'CHILD' -%}CHILD
{%- elif s == 'PARENT' -%}PARENT
{%- elif s == 'SIBLING' -%}SIBLING
{%- elif 'OTHER' in s -%}OTHER_RELATIVE
{%- elif s -%}OTHER
{%- else -%}SELF
{%- endif -%}
{%- endmacro -%}
{%- macro residency_enum(raw) -%}
{%- set s = norm(raw) | replace(' ', '_') -%}
{%- if s == 'USUAL_MEMBER' -%}USUAL_MEMBER
{%- elif s == 'TEMPORARY' -%}TEMPORARY
{%- elif s == 'ABSENT' -%}ABSENT
{%- elif s -%}USUAL_MEMBER
{%- else -%}USUAL_MEMBER
{%- endif -%}
{%- endmacro -%}
{%- macro citizenship_enum(raw) -%}
{%- set s = norm(raw) | replace(' ', '_') -%}
{%- if s in ['CITIZEN', 'REFUGEE', 'IDP', 'RETURNEE', 'RESIDENT'] -%}{{ s }}
{%- elif s -%}CITIZEN
{%- else -%}CITIZEN
{%- endif -%}
{%- endmacro -%}
{%- macro displacement_enum(raw) -%}
{%- set s = norm(raw) | replace(' ', '_') -%}
{%- if s in ['HOST_COMMUNITY', 'IDP', 'RETURNEE', 'REFUGEE'] -%}{{ s }}
{%- elif s -%}HOST_COMMUNITY
{%- else -%}
{%- endif -%}
{%- endmacro -%}
{%- macro pastoralist_enum(raw) -%}
{%- set s = norm(raw) | replace(' ', '_') -%}
{%- if s in ['PASTORALIST', 'SEMI_PASTORALIST', 'SETTLED'] -%}{{ s }}
{%- elif s -%}SETTLED
{%- else -%}
{%- endif -%}
{%- endmacro -%}
{%- set m = expanded if expanded is defined else {} -%}
{%- set demo = m.get('demographic_info', {}) -%}
{%- set name = demo.get('name', {}) if demo is mapping else {} -%}
{%- set mids = m.get('member_identifier', []) -%}
{%- set id_ns = namespace(uin='', nat='') -%}
{%- for x in mids if mids is iterable and mids is not string -%}
  {%- if (x.get('identifier_type') or '') | upper in ['UIN'] -%}
    {%- set id_ns.uin = x.get('identifier_value') or '' -%}
  {%- endif -%}
{%- endfor -%}
{%- set dids = demo.get('identifier', []) if demo is mapping else [] -%}
{%- for x in dids if dids is iterable and dids is not string -%}
  {%- if (x.get('identifier_type') or '') | upper in ['NATIONALID', 'NATIONAL_ID', 'NATIONAL ID'] -%}
    {%- set id_ns.nat = x.get('identifier_value') or '' -%}
  {%- endif -%}
{%- endfor -%}
{%- if not id_ns.nat and dids and dids[0] is mapping -%}
  {%- set id_ns.nat = dids[0].get('identifier_value') or '' -%}
{%- endif -%}
{%- set uin = id_ns.uin or id_ns.nat -%}
{%- set nat = id_ns.nat or id_ns.uin -%}
{%- set phone_arr = demo.get('phone_number') if demo is mapping else [] -%}
{%- set p0 = (phone_arr[0] if phone_arr is iterable and phone_arr is not string and phone_arr | length > 0 else '') | string -%}
{%- set p1 = (phone_arr[1] if phone_arr is iterable and phone_arr is not string and phone_arr | length > 1 else '') | string -%}
{%- set langs = m.get('language_code', []) -%}
{%- set lang_str = '' -%}
{%- if langs is iterable and langs is not string -%}
  {%- set lang_str = langs | join(', ') -%}
{%- elif langs -%}
  {%- set lang_str = langs | string -%}
{%- endif -%}
{# additional_attributes: single dict (after G2PDciIndividualCreateEnricherService merge) or raw list from tests #}
{%- set raw_addl = m.get('additional_attributes') -%}
{%- if raw_addl is mapping -%}
  {%- set addl = raw_addl -%}
{%- elif raw_addl is iterable and raw_addl is not string and raw_addl | length > 0 and raw_addl[0] is mapping -%}
  {%- set addl = raw_addl[0] -%}
{%- else -%}
  {%- set addl = {} -%}
{%- endif -%}
{%- set rec_name = ((name.get('given_name', name.get('first_name', '')) ~ ' ' ~ (name.get('surname', name.get('last_name', '')))) | trim) -%}
{%- set primary_liv = livelihood_from_text(addl.get('primary_livelihood', '')) -%}
{%- set secondary_liv = livelihood_from_text(addl.get('secondary_livelihood', '')) -%}
{%- set emp = employment_enum(m.get('employment_status', '')) -%}
{%- set dsp = displacement_enum(addl.get('displacement_status')) -%}
{%- set pst = pastoralist_enum(addl.get('pastoralist_classification')) -%}
{%- set dis_rows = m.get('disability_info', []) -%}
{%- set sid = m.get('self_id_disability') -%}
{%- set dstatus = 'UNKNOWN' -%}
{%- if sid == 1 or sid == '1' -%}
  {%- set dstatus = 'YES' -%}
{%- elif sid == 0 or sid == '0' -%}
  {%- set dstatus = 'NO' -%}
{%- elif sid is not none and sid != '' -%}
  {%- set dstatus = 'UNKNOWN' -%}
{%- elif m.get('is_disabled') is sameas true or m.get('is_disabled') == 1 or m.get('is_disabled') == '1' or ((m.get('is_disabled') | string | lower) == 'true') -%}
  {%- set dstatus = 'YES' -%}
{%- elif m.get('is_disabled') is sameas false or m.get('is_disabled') == 0 or m.get('is_disabled') == '0' or ((m.get('is_disabled') | string | lower) == 'false') -%}
  {%- set dstatus = 'NO' -%}
{%- elif dis_rows is iterable and dis_rows is not string and dis_rows | length > 0 -%}
  {%- set dstatus = 'YES' -%}
{%- endif -%}
{%- set occ = (m.get('occupation') or '') | string | trim -%}
{%- if not occ and addl.get('occupation') -%}
  {%- set occ = addl.get('occupation') | string | trim -%}
{%- endif -%}
{
  "in_header_info": [
    {
      "record_name": {{ rec_name | tojson }},
      "record_status": "ACTIVE",
      "functional_record_id": {{ uin | tojson }}
    }
  ],
  "in_demographic_details": [
    {
      "first_name": {{ (name.get('given_name') or name.get('first_name') or '') | tojson }},
      "middle_name": {{ (name.get('second_name') or name.get('middle_name') or '') | tojson }},
      "last_name": {{ (name.get('surname') or name.get('last_name') or '') | tojson }},
      "alias_names": [],
      "birth_date": {{ ((demo.get('birth_date') or '') | string).split('T')[0] | tojson }},
      "gender": {{ gender_enum(demo.get('sex')) | tojson }},
      "marital_status": {{ marital_enum(m.get('marital_status')) | tojson }},
      "citizenship_category": {{ citizenship_enum(addl.get('citizenship_category')) | tojson }},
      "education_level": {{ education_level_norm(m.get('education_level')) | tojson }},
      "language_code": {{ lang_str | tojson }},
      "registration_date": {{ ((m.get('registration_date') or demo.get('registration_date') or '') | string).split('T')[0] | tojson }}
    }
  ],
  "in_contact_details": [
    {
      "primary_phone": {{ p0 | tojson }},
      "alternate_phone": {{ p1 | tojson }},
      "contact_person_name": "",
      "preferred_contact_method": "CALL"
    }
  ],
  "in_identifier": [
    {
      "foundational_id": {{ nat | tojson }},
      "rid": ""
    }
  ],
  "in_relationship_to_head": [
    {
      "relationship_to_head": {{ rel_to_head(addl.get('relationship_to_head')) | tojson }},
      "dependency_indicator": false,
      "residency_status": {{ residency_enum(addl.get('residency_status')) | tojson }}
    }
  ],
  "in_location_details": [
    {
      "address_line_1": "",
      "address_line_2": "",
      "postal_code": "",
      "geo_lowest_level_value_id": ""
    }
  ],
  "in_scores": [],
  "in_livelihood_employment": [
    {
      "primary_livelihood": {% if primary_liv %}{{ primary_liv | tojson }}{% else %}null{% endif %},
      "secondary_livelihood": {% if secondary_liv %}{{ secondary_liv | tojson }}{% else %}null{% endif %},
      "employment_status": {% if emp %}{{ emp | tojson }}{% else %}null{% endif %},
      "occupation": {{ occ | tojson }},
      "income_level": {{ income_level_norm(m.get('income_level')) | tojson }},
      "coping_strategies_index": null
    }
  ],
  "in_table_land": [
    {
      "land_access": false,
      "land_size": null,
      "productive_assets": []
    }
  ],
  "in_table_livestock": [],
  "in_table_shocks": [],
  "in_vulnerability_inclusion": [
    {
      "disability_status": {{ dstatus | tojson }},
      "orphanhood_flag": false,
      "chronic_illness_flag": false,
      "displacement_status": {% if dsp %}{{ dsp | tojson }}{% else %}null{% endif %},
      "pastoralist_classification": {% if pst %}{{ pst | tojson }}{% else %}null{% endif %},
      "high_mobility_indicator": false,
      "plw_status": false
    }
  ],
  "in_table_disabilities": [
{%- if dis_rows is iterable and dis_rows is not string -%}
  {%- for row in dis_rows -%}
    {%- if row is mapping -%}
    {
      "disability_domain": {{ domain_from_dci(row.get('functional_limitation_type')) | tojson }},
      "disability_severity": {{ severity_from_dci(row.get('functional_limitations_level')) | tojson }}
    }{% if not loop.last %},{% endif %}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
  ],
  "in_table_program_enrolments": []
}
